<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apotheca Rx — 5 Danh Mục Dược Phẩm</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-[#f0f7f3] text-slate-800 min-h-screen">
  <div class="max-w-7xl mx-auto p-6 md:p-10">
    
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white font-black text-2xl flex items-center justify-center shadow-lg shadow-emerald-600/20">
          +
        </div>
        <div>
          <h1 class="text-2xl font-black text-slate-900 tracking-tight">Hệ Thống Phân Loại 5 Nhóm Dược Phẩm</h1>
          <p class="text-xs text-emerald-700 font-semibold">Apotheca Rx Clinical Portal • Phase 2 Category Hub</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/dashboard11.html" class="px-4 py-2.5 bg-white border border-slate-200 text-slate-700 hover:text-emerald-700 rounded-xl font-bold text-xs shadow-sm hover:shadow transition flex items-center gap-2">
          <span>← Về Dashboard Chính</span>
        </a>
        <a href="/categories.html" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow-md shadow-emerald-600/20 transition flex items-center gap-2">
          <span>⚡ Tra Cứu Tương Tác (SPA) →</span>
        </a>
      </div>
    </div>

    <!-- Overview Banner -->
    <div class="bg-gradient-to-r from-emerald-700 via-emerald-600 to-teal-600 rounded-3xl p-8 text-white shadow-xl shadow-emerald-800/15 mb-10 relative overflow-hidden">
      <div class="relative z-10 max-w-2xl">
        <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[11px] font-bold uppercase tracking-wider mb-3 inline-block">Phase 2 — Categorization</span>
        <h2 class="text-3xl font-extrabold mb-2">Kho Dữ Liệu Dược Phẩm Chuẩn Hóa</h2>
        <p class="text-emerald-100 text-sm leading-relaxed mb-6">
          Quản lý toàn diện hơn 2,000+ sản phẩm y tế được phân loại chính xác theo 5 nhóm danh mục nghiệp vụ: Thuốc chữa bệnh, Hàng đặc trị, Vật tư y tế, Thực phẩm bảo vệ sức khỏe và Dược mỹ phẩm.
        </p>
        <div class="flex flex-wrap items-center gap-4 text-xs font-bold">
          <div class="px-4 py-2 bg-white/10 rounded-xl backdrop-blur-md border border-white/20">
            Tổng sản phẩm: <span class="text-amber-300 font-extrabold"><%= totalMedicines || 2059 %></span>
          </div>
          <div class="px-4 py-2 bg-white/10 rounded-xl backdrop-blur-md border border-white/20">
            Nhà sản xuất: <span class="text-amber-300 font-extrabold"><%= nsxCount || 48 %></span>
          </div>
          <div class="px-4 py-2 bg-white/10 rounded-xl backdrop-blur-md border border-white/20">
            Nhà cung cấp: <span class="text-amber-300 font-extrabold"><%= nccCount || 35 %></span>
          </div>
        </div>
      </div>
      <div class="absolute -right-8 -bottom-10 opacity-20 text-[180px] select-none pointer-events-none">
        💊
      </div>
    </div>

    <!-- 5 Categories Grid -->
    <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
      <span>📂</span> Chọn danh mục cần quản lý:
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      
      <!-- 1. Thuốc -->
      <a href="/thuoc" class="group bg-white rounded-3xl p-6 border border-emerald-100 hover:border-emerald-300 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              💊
            </div>
            <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold">Group 01</span>
          </div>
          <h4 class="text-lg font-black text-slate-900 group-hover:text-emerald-700 transition mb-1">1. Danh mục Thuốc</h4>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Thuốc BHYT, thuốc kê đơn & không kê đơn, kháng sinh, thuốc tim mạch, hạ áp, tiêu hóa.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-600">
          <span>Xem danh sách →</span>
          <span class="text-slate-400 font-medium">Bấm để mở</span>
        </div>
      </a>

      <!-- 2. Hàng đặc trị -->
      <a href="/hangdactri" class="group bg-white rounded-3xl p-6 border border-rose-100 hover:border-rose-300 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🏥
            </div>
            <span class="px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-bold">Group 02</span>
          </div>
          <h4 class="text-lg font-black text-slate-900 group-hover:text-rose-700 transition mb-1">2. Hàng Đặc Trị</h4>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Thuốc kiểm soát đặc biệt, thuốc điều trị ung thư, thuốc gây nghiện & hướng thần, tiền chất.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-rose-600">
          <span>Xem danh sách →</span>
          <span class="text-slate-400 font-medium">Bấm để mở</span>
        </div>
      </a>

      <!-- 3. VTYT -->
      <a href="/vtyt" class="group bg-white rounded-3xl p-6 border border-blue-100 hover:border-blue-300 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🧪
            </div>
            <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold">Group 03</span>
          </div>
          <h4 class="text-lg font-black text-slate-900 group-hover:text-blue-700 transition mb-1">3. Vật Tư & TBYT</h4>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Vật tư y tế tiêu hao, bơm kim tiêm, bông băng gạc, dây truyền dịch, găng tay, thiết bị theo dõi.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600">
          <span>Xem danh sách →</span>
          <span class="text-slate-400 font-medium">Bấm để mở</span>
        </div>
      </a>

      <!-- 4. TPCN -->
      <a href="/tpcn" class="group bg-white rounded-3xl p-6 border border-amber-100 hover:border-amber-300 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🍃
            </div>
            <span class="px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-bold">Group 04</span>
          </div>
          <h4 class="text-lg font-black text-slate-900 group-hover:text-amber-700 transition mb-1">4. Thực Phẩm Chức Năng</h4>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Thực phẩm bảo vệ sức khỏe, vitamin & khoáng chất, men vi sinh, dầu cá Omega, bổ gan, bổ thận.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-amber-600">
          <span>Xem danh sách →</span>
          <span class="text-slate-400 font-medium">Bấm để mở</span>
        </div>
      </a>

      <!-- 5. DMP -->
      <a href="/dmp" class="group bg-white rounded-3xl p-6 border border-purple-100 hover:border-purple-300 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-14 h-14 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              ✨
            </div>
            <span class="px-3 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-bold">Group 05</span>
          </div>
          <h4 class="text-lg font-black text-slate-900 group-hover:text-purple-700 transition mb-1">5. Dược Mỹ Phẩm</h4>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Dung dịch sát trùng, cồn y tế, nước muối sinh lý, kem da liễu, serum phục hồi, mỹ phẩm y khoa.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-purple-600">
          <span>Xem danh sách →</span>
          <span class="text-slate-400 font-medium">Bấm để mở</span>
        </div>
      </a>

      <!-- Quick Action Card: Export All -->
      <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-3xl p-6 text-white shadow-xl flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-2xl mb-4">
            📥
          </div>
          <h4 class="text-lg font-black mb-1">Xuất Dữ Liệu Nhanh</h4>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Tải về toàn bộ cơ sở dữ liệu cả 5 nhóm thuốc dạng CSV hoặc Excel với định dạng UTF-8 chuẩn.
          </p>
        </div>
        <div class="flex gap-2">
          <a href="/api/medicines-db/export/all" class="flex-1 text-center py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold text-xs transition">
            Xuất CSV
          </a>
          <a href="/api/export/medicines/excel" class="flex-1 text-center py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-bold text-xs transition">
            Xuất Excel
          </a>
        </div>
      </div>

    </div>

    <!-- Phase Navigation Bar -->
    <div class="bg-white rounded-2xl p-4 border border-emerald-100 flex flex-wrap items-center justify-between gap-4 text-xs">
      <div class="flex items-center gap-2 text-slate-600 font-medium">
        <span class="font-bold text-slate-800">Truy cập nhanh các giai đoạn:</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/bulk-data.html" class="px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-800 font-bold hover:bg-emerald-100 transition">⏳ Phase 3: Bulk Import/Export</a>
        <a href="/report-pharmacist.html" class="px-3 py-1.5 rounded-lg bg-blue-50 text-blue-800 font-bold hover:bg-blue-100 transition">📊 Phase 4: Reports Dược Sĩ</a>
        <a href="/report-worker.html" class="px-3 py-1.5 rounded-lg bg-amber-50 text-amber-800 font-bold hover:bg-amber-100 transition">📋 Phase 5: Reports Nhân Viên</a>
        <a href="/report-budget-salary.html" class="px-3 py-1.5 rounded-lg bg-purple-50 text-purple-800 font-bold hover:bg-purple-100 transition">💰 Phase 6: Ngân Sách & Lương</a>
      </div>
    </div>

  </div>
</body>
</html>
