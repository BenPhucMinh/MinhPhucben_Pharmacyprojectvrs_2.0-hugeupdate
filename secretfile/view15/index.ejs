            📥 Xuất danh sách ra CSV
        </button>
    </div>

    <script>
        // Change this to match your category: thuoc / hangdactri / vtyt / tpcn / dmp
        const currentCategory = 'thuoc';

        function exportCSV() {
            window.location.href = `/api/medicines-db/export/${currentCategory}`;
        }
    </script>
</body>

